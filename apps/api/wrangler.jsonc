{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gift-shop-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-shop-db-develop",
      "database_id": "3954eb31-dc9c-4b0d-8a67-6e21b05570aa",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "gift-shop-files-develop"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "martinezyashira8@gmail.com"
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "ADMIN_SESSION_SECRET"]
  },
  "env": {
    "develop": {
      "name": "gift-shop-api-develop",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gift-shop-db-develop",
          "database_id": "3954eb31-dc9c-4b0d-8a67-6e21b05570aa",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "gift-shop-files-develop"
        }
      ],
      "vars": {
        "ADMIN_EMAIL": "martinezyashira8@gmail.com"
      }
    },
    "production": {
      "name": "gift-shop-api-production",
      "workers_dev": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gift-shop-db-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "gift-shop-files"
        }
      ],
      "vars": {
        "ADMIN_EMAIL": "martinezyashira8@gmail.com"
      }
    }
  }
}
