{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gift-shop-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gift-shop-db-develop",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "develop": {
      "name": "gift-shop-api-develop",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gift-shop-db-develop",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "gift-shop-api-production",
      "workers_dev": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gift-shop-db-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
