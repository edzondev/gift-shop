{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gift-shop-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "vars": {
    "YAPE_NUMBER": "REEMPLAZAR",
    "YAPE_NAME": "REEMPLAZAR"
  },
  "services": [{ "binding": "API", "service": "gift-shop-api" }],
  "env": {
    "develop": {
      "name": "gift-shop-web-develop",
      "workers_dev": true,
      "vars": {
        "YAPE_NUMBER": "REEMPLAZAR",
        "YAPE_NAME": "REEMPLAZAR"
      },
      "services": [{ "binding": "API", "service": "gift-shop-api-develop" }]
    },
    "production": {
      "name": "gift-shop-web-production",
      "workers_dev": false,
      "vars": {
        "YAPE_NUMBER": "REEMPLAZAR",
        "YAPE_NAME": "REEMPLAZAR"
      },
      "services": [{ "binding": "API", "service": "gift-shop-api-production" }]
    }
  }
}
